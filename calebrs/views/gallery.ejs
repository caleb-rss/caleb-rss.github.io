<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= typeof galleryTitle !== 'undefined' && galleryTitle ? 'calebrs.com | ' + galleryTitle : 'calebrs.com | gallery' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="alternate icon" href="/favicon-32.png">
</head>
<body>
    <main class="gallery-shell">
        <header class="gallery-header">
            <p class="eyebrow">02. photography</p>
            <h1><%= typeof galleryTitle !== 'undefined' && galleryTitle ? galleryTitle : 'photo gallery' %></h1>
            <% if (typeof galleryLabel !== 'undefined' && galleryLabel) { %>
                <p class="gallery-badge">private archive / <%= galleryLabel %></p>
            <% } %>
            <p class="gallery-intro">
                <%= typeof galleryDescription !== 'undefined' && galleryDescription ? galleryDescription : 'Some frames from the road, the night, and the places in between.' %>
            </p>

            <div class="gallery-actions">
                <a href="/">← back home</a>
                <% if (typeof galleryAccess !== 'undefined' && galleryAccess) { %>
                    <a href="/gallery/access">[choose archive]</a>
                <% } else { %>
                    <a href="/#photos">photography</a>
                <% } %>
            </div>
        </header>

        <% if (typeof galleryAccess !== 'undefined' && galleryAccess) { %>
            <div class="gallery-filters">
                <button data-filter="all" class="active">[all]</button>
            </div>
        <% } else { %>
            <div class="gallery-filters">
                <button data-filter="all" class="active">[all]</button>
                <button data-filter="night">[night]</button>
                <button data-filter="places">[places]</button>
                <button data-filter="portraits">[portraits]</button>
            </div>
        <% } %>

        <% if (photos && photos.length) { %>
            <section class="gallery-grid" aria-label="Photo gallery">
                <% photos.forEach((photo) => { %>
                    <figure
                        class="gallery-card"
                        data-category="<%= photo.category %>"
                        data-full-src="<%= photo.fullSrc %>"
                        data-caption="<%= photo.category %> / <%= photo.index %>"
                    >
                        <img src="<%= photo.src %>" alt="<%= photo.alt %>" loading="lazy">
                        <figcaption>
                            <span><%= photo.category %></span>
                            <span>0<%= photo.index %></span>
                        </figcaption>
                    </figure>
                <% }) %>
            </section>
        <% } else { %>
            <section class="gallery-empty" aria-live="polite">
                <p>no photos in this archive yet.</p>
            </section>
        <% } %>
    </main>

    <div class="lightbox" aria-hidden="true">
        <button class="lightbox-close" aria-label="Close lightbox">×</button>
        <button class="lightbox-nav prev" aria-label="Previous image">‹</button>
        <img class="lightbox-image" src="" alt="Expanded view">
        <button class="lightbox-nav next" aria-label="Next image">›</button>
        <div class="lightbox-caption"></div>
    </div>

    <script src="/js/gallery.js"></script>
</body>
</html>
